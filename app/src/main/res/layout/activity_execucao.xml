<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/exec_bg"
    tools:context=".ExecucaoActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Cabeçalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnVoltar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/exec_bg_chip"
                    android:contentDescription="@string/exec_voltar"
                    android:padding="8dp"
                    android:src="@drawable/exec_ic_arrow_back"
                    app:tint="@color/exec_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/exec_titulo"
                    android:textColor="@color/exec_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nome do exercício e série -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:text="@string/exec_nome_exercicio"
                android:textColor="@color/exec_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/exec_serie"
                android:textColor="@color/exec_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Ilustração do exercício -->
            <ImageView
                android:id="@+id/ivExercicio"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/exec_bg_imagem"
                android:clipToOutline="true"
                android:contentDescription="@string/exec_imagem_desc"
                android:scaleType="centerCrop"
                android:src="@drawable/exec_img_exercicio" />

            <!-- Carga e repetições -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/exec_carga"
                        android:textColor="@color/exec_text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/exec_bg_campo"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnMenosCarga"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:contentDescription="@string/exec_diminuir_carga"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/exec_menos"
                            android:textColor="@color/exec_orange"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCarga"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="40"
                            android:textColor="@color/exec_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnMaisCarga"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:contentDescription="@string/exec_aumentar_carga"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/exec_mais"
                            android:textColor="@color/exec_orange"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/exec_repeticoes"
                        android:textColor="@color/exec_text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/exec_bg_campo"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnMenosReps"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:contentDescription="@string/exec_diminuir_repeticoes"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/exec_menos"
                            android:textColor="@color/exec_orange"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvReps"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="12"
                            android:textColor="@color/exec_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnMaisReps"
                            android:layout_width="40dp"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:contentDescription="@string/exec_aumentar_repeticoes"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/exec_mais"
                            android:textColor="@color/exec_orange"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Tempo de descanso -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exec_descanso"
                    android:textColor="@color/exec_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_gravity="top"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="1dp"
                    android:background="@drawable/exec_bg_ponto_vermelho" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/exec_bg_anel">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exec_tempo"
                        android:textColor="@color/exec_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exec_restante"
                        android:textColor="@color/exec_orange"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Botões -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPausar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/exec_bg_btn_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/exec_pausar"
                    android:textColor="@color/exec_orange"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnConcluir"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/exec_bg_btn_primario"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/exec_concluir"
                    android:textColor="@color/exec_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>