<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/treino_bg"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:text="@string/meus_treinos_titulo"
        android:textColor="@color/treino_text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Abas Atual / Histórico -->
    <LinearLayout
        android:id="@+id/containerTabs"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_tabs"
        android:orientation="horizontal"
        android:padding="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo">

        <TextView
            android:id="@+id/tabAtual"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selecionada"
            android:gravity="center"
            android:text="@string/meus_treinos_tab_atual"
            android:textColor="@color/treino_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabHistorico"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/meus_treinos_tab_historico"
            android:textColor="@color/treino_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lista de treinos (cada card usa o layout item_treino.xml) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTreinos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerTabs"
        tools:listitem="@layout/item_treino" />

    <!-- Barra inferior (só visual por enquanto) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/navInicio"
            style="@style/NavItem"
            android:drawableTop="@drawable/ic_home"
            android:text="@string/nav_inicio" />

        <TextView
            android:id="@+id/navTreinos"
            style="@style/NavItem"
            android:drawableTop="@drawable/ic_dumbbell"
            android:drawableTint="@color/treino_orange"
            android:text="@string/nav_treinos"
            android:textColor="@color/treino_orange"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navAcademia"
            style="@style/NavItem"
            android:drawableTop="@drawable/ic_academia"
            android:text="@string/nav_academia" />

        <TextView
            android:id="@+id/navComunidade"
            style="@style/NavItem"
            android:drawableTop="@drawable/ic_comunidade"
            android:text="@string/nav_comunidade" />

        <TextView
            android:id="@+id/navPerfil"
            style="@style/NavItem"
            android:drawableTop="@drawable/ic_perfil"
            android:text="@string/nav_perfil" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>