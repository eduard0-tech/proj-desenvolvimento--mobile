<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_recovery_dialog"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/recovery_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/recovery_title"
            android:textColor="@color/orange_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_recovery" />

        <TextView
            android:id="@+id/recovery_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/recovery_description"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/input_recovery_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/bg_login_field"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="12dp"
            android:fontFamily="sans-serif"
            android:hint="@string/recovery_email_hint"
            android:contentDescription="@string/recovery_email_hint"
            android:imeOptions="actionDone"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Gyema"
            android:textColor="@color/white"
            android:textColorHint="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/button_recovery_submit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_primary"
            android:backgroundTint="@null"
            android:drawableEnd="@drawable/ic_arrow"
            android:paddingHorizontal="24dp"
            android:stateListAnimator="@null"
            android:text="@string/request_recovery"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
