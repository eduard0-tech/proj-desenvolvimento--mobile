<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome"
    tools:context=".LoginActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="804dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_pattern" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="804dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="48dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.22"
                android:text="@string/login_welcome"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginTop="20dp"
                android:contentDescription="@string/brand_description"
                android:src="@drawable/ic_gyema" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/brand"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/academy"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.06"
                android:text="@string/login"
                android:textColor="@color/orange_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/login_description"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/input_email"
                android:text="@string/email_label"
                android:textColor="#9C8BBB"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_email"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_login_field"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="12dp"
                android:fontFamily="sans-serif"
                android:hint="@string/email_hint"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Gyema"
                android:textColor="@color/white"
                android:textColorHint="#B3A9CD"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/input_password"
                    android:text="@string/password_label"
                    android:textColor="#9C8BBB"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_forgot_password"
                    style="@style/WelcomeFooter"
                    android:text="@string/forgot_password"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp">

                <EditText
                    android:id="@+id/input_password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="12dp"
                    android:fontFamily="sans-serif"
                    android:hint="@string/password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingVertical="0dp"
                    android:saveEnabled="false"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Gyema"
                    android:textColor="@color/white"
                    android:textColorHint="#B3A9CD"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/button_password_visibility"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/show_password"
                    android:padding="14dp"
                    android:src="@drawable/ic_eye_off" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/checkbox_remember_user"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="#ADA0BA"
                android:fontFamily="sans-serif"
                android:text="@string/remember_user"
                android:textAppearance="@style/TextAppearance.Gyema"
                android:textColor="#ADA0BA"
                android:textSize="11sp" />

            <Button
                android:id="@+id/button_submit_login"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_login_button"
                android:backgroundTint="@null"
                android:drawableEnd="@drawable/ic_arrow"
                android:drawableTint="@color/muted"
                android:paddingHorizontal="32dp"
                android:stateListAnimator="@null"
                android:text="@string/login"
                android:textAllCaps="false"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <Button
                android:id="@+id/button_login_register"
                style="@style/WelcomeFooter"
                android:layout_marginTop="4dp"
                android:text="@string/no_account"
                android:textColor="#ADA0BA"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_back"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        android:contentDescription="@string/back" />
</FrameLayout>
