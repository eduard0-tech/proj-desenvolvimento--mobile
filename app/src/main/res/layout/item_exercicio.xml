<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_treino"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvNumero"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_numero_exercicio"
        android:gravity="center"
        android:textColor="@color/treino_orange"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomeExercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/treino_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Supino reto" />

        <TextView
            android:id="@+id/tvSeriesRepeticoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/treino_text_secondary"
            android:textSize="12sp"
            tools:text="4 séries x 12 repetições" />
    </LinearLayout>
</LinearLayout>
